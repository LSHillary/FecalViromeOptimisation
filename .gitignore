#------------------------------------------------
# R-specific ignores
#------------------------------------------------

# History files
.Rhistory
.Rapp.history

# Session data
.RData
.RDataTmp
.Ruserdata

# R environment variables
.Renviron

# Example code in package build process
*-Ex.R

# Output from R CMD build/check
/*.tar.gz
/*.Rcheck/

# RStudio project files
.Rproj.user/

# knitr and R Markdown cache/output
*_cache/
/cache/
*.utf8.md
*.knit.md

# Vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth tokens
.httr-oauth

# RStudio Connect
rsconnect/

# pkgdown site
docs/

#------------------------------------------------
# Project-specific folders and pipelines
#------------------------------------------------

# Common data/output folders
.snakemake/
Virome/

#------------------------------------------------
# Tool-specific files
#------------------------------------------------

# SortMeRNA
*kvdb
*readb

#------------------------------------------------
# Log and temporary files
#------------------------------------------------

# Log files
*.log
*.out
*.err

# Swap/temp files
*swp

